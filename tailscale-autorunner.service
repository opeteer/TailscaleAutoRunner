[Unit]
Description=Tailscale AutoRunner
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/opeteer/TailscaleAutoRunner/main.py
Restart=always
RestartSec=10
User=root

# Tanpa batas percobaan (pantang menyerah walaupun router butuh waktu lama untuk hidup)
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
